# Copy to .env.local for development, and mirror every value into the Vercel
# project settings. Never commit .env.local.

# Supabase — project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS: it is the only key that can write bookings.
# Must never appear in a NEXT_PUBLIC_ variable or reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email (booking confirmations, owner alerts)
RESEND_API_KEY=
# Owner's inbox for new-booking alerts
ADMIN_EMAIL=

# Absolute site origin, no trailing slash. Used for emails, sitemap and OG
# tags. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://[DOMAIN]

# Phase 2 only (SPEC §10). Leave empty until the FastAPI quote engine is
# calibrated against 30-50 logged jobs.
QUOTE_ENGINE_URL=
