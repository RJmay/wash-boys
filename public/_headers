# Cache headers for Workers static assets.
#
# Everything under /_next/static/ has a content hash in its filename - JS
# chunks, CSS, fonts and the statically imported job photos. A hashed name can
# never change content, so revalidating it is a wasted round trip. The default
# Workers asset header is `max-age=0, must-revalidate`, which makes a repeat
# visitor pay one conditional request per file before the page can paint. On
# 4G at ~170ms RTT that is the difference a returning customer actually feels.
#
# Only hashed paths belong here. Anything served under a stable name - the
# placeholder images, the HTML itself - must keep revalidating, or replacing a
# file leaves browsers holding the old one for a decade.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
