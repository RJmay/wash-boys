{
  "$schema": "node_modules/wrangler/config-schema.json",
  // MUST match the Workers Builds project name. wrangler deploys to the Worker
  // named here, not to the project running the build, so a mismatch silently
  // creates a second Worker and the project you are watching never updates.
  "name": "wash-boys-biz",
  "main": ".open-next/worker.js",
  // workerd bundled with wrangler 4.125 is 1.20260820.x - do not set this
  // ahead of the runtime or the deploy is rejected.
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Native image optimisation in Workers. This is what lets us keep using
  // next/image for the before/after photos instead of shipping originals.
  "images": {
    "binding": "IMAGES"
  },
  // Worker logs. We will want these the first time a booking fails at 7am.
  "observability": {
    "enabled": true
  }
}
